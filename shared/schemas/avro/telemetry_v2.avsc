{
  "type": "record",
  "name": "Telemetry",
  "namespace": "ilmop.telemetry",
  "fields": [
    {
      "name": "satellite_id",
      "type": "string"
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-micros"
      }
    },
    {
      "name": "latitude_deg",
      "type": "double"
    },
    {
      "name": "longitude_deg",
      "type": "double"
    },
    {
      "name": "altitude_km",
      "type": "double"
    },
    {
      "name": "in_eclipse",
      "type": "boolean"
    },
    {
      "name": "in_contact",
      "type": "boolean"
    },
    {
      "name": "orbit_type",
      "type": {
        "type": "enum",
        "name": "OrbitType",
        "symbols": [
          "LEO_CIRCULAR",
          "HEO_MOLNIYA"
        ]
      },
      "default": "LEO_CIRCULAR"
    },
    {
      "name": "battery_pct",
      "type": "double"
    },
    {
      "name": "battery_voltage_v",
      "type": "double"
    },
    {
      "name": "solar_panel_power_w",
      "type": "double"
    },
    {
      "name": "temperature_c",
      "type": "double"
    },
    {
      "name": "cpu_utilization_pct",
      "type": "double"
    },
    {
      "name": "memory_utilization_pct",
      "type": "double"
    },
    {
      "name": "downlink_rate_mbps",
      "type": "double"
    },
    {
      "name": "uplink_rate_mbps",
      "type": "double"
    },
    {
      "name": "safe_mode",
      "type": "boolean",
      "default": false
    },
    {
      "name": "anomaly_flag",
      "type": "boolean",
      "default": false
    },
    {
      "name": "fault_injected",
      "type": "boolean",
      "default": false
    }
  ],
  "doc": "Satellite telemetry snapshot. Generated from shared/schemas/telemetry_schema.py."
}
