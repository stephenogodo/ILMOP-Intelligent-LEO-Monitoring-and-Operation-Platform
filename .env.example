# ILMOP Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Format the PRODUCERS write: json (default) or avro.  Consumers always read
# both.  Upgrade every consumer first, and only then set this to avro (ADR-023).
# KAFKA_SERIALIZATION=json

# ── Commands (Sprint 9) ──────────────────────────────────────────────────────
# Turns on uplink in the API and the acknowledgement listener, and the command
# listener in the telemetry producer.  Off by default.
# COMMANDS_ENABLED=false

# Accounts for the command REST endpoints, as ONE line of JSON in single quotes.
# Empty means no accounts: every command endpoint then answers 503.
# There are no default credentials.  Secrets must be at least 8 characters.
# Roles: AUTHOR (submit), APPROVER (approve/reject, human OPERATOR only),
# UPLINKER (uplink).  Kinds: OPERATOR (human) or SYSTEM.
# COMMAND_ACCOUNTS_JSON='[{"name": "stephen", "secret": "change-me-please", "kind": "OPERATOR", "roles": ["AUTHOR", "APPROVER"]}, {"name": "uplink", "secret": "change-me-too-please", "kind": "SYSTEM", "roles": ["UPLINKER"]}]'

# Satellites whose acknowledgement topics the API listens to (comma separated).
# COMMAND_SATELLITES=SAT-001

# ── Frame ingest (Sprint 9) ──────────────────────────────────────────────────
# Satellite name -> CCSDS spacecraft ID, and the bytes per transfer frame.
# INGEST_SATELLITE_SCIDS=SAT-001=1,SAT-002=2
# INGEST_FRAME_LENGTH=1115

# ── TimescaleDB ───────────────────────────────────────────────────────────────
TIMESCALEDB_HOST=localhost
TIMESCALEDB_PORT=5432
TIMESCALEDB_NAME=ilmop
TIMESCALEDB_USER=ilmop
TIMESCALEDB_PASSWORD=ilmop

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# ── Simulator ─────────────────────────────────────────────────────────────────
SIMULATOR_SATELLITE_ID=SAT-001
SIMULATOR_TICK_INTERVAL_S=1.0

# ── Azure (Sprint 10) ────────────────────────────────────────────────────────
# KAFKA_BOOTSTRAP_SERVERS=<event-hubs-namespace>.servicebus.windows.net:9093
# TIMESCALEDB_HOST=<azure-postgres-server>.postgres.database.azure.com
