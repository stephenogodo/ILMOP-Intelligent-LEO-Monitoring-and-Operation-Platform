# ILMOP Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── TimescaleDB ───────────────────────────────────────────────────────────────
TIMESCALEDB_HOST=localhost
TIMESCALEDB_PORT=5432
TIMESCALEDB_NAME=ilmop
TIMESCALEDB_USER=ilmop
TIMESCALEDB_PASSWORD=ilmop

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# ── Simulator ─────────────────────────────────────────────────────────────────
SIMULATOR_SATELLITE_ID=SAT-001
SIMULATOR_TICK_INTERVAL_S=1.0

# ── Azure (Sprint 7) ─────────────────────────────────────────────────────────
# KAFKA_BOOTSTRAP_SERVERS=<event-hubs-namespace>.servicebus.windows.net:9093
# TIMESCALEDB_HOST=<azure-postgres-server>.postgres.database.azure.com
